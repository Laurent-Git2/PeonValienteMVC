@model PeonValienteMVC.Models.Pedido

@{
    ViewData["Title"] = "Detalles Pedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Pedido</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Fecha)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Fecha)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Confirmado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Confirmado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Preparado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Preparado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Enviado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Enviado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cobrado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cobrado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Devuelto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Devuelto)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Anulado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Anulado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cliente)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cliente.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado.Descripcion)
        </dd>
    </dl>
</div>
<hr />

<h4>Líneas del Pedido</h4>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @{
            decimal totalGeneral = 0;
        }

        @foreach (var item in Model.Detalles)
        {
            decimal totalLinea = item.Cantidad * item.Precio;
            totalGeneral += totalLinea;

            <tr>
                <td>@item.Producto?.Descripcion</td>
                <td>@item.Cantidad</td>
                <td>@item.Precio €</td>
                <td>@totalLinea €</td>
            </tr>
        }
    </tbody>
</table>

<h5>Total Pedido: @totalGeneral €</h5>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver a la Lista</a>
</div>
