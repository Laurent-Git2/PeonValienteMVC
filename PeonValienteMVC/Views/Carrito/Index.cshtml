@model PeonValienteMVC.Models.Pedido

<h2>Carrito de la compra</h2>


@{
    decimal totalGeneral = 0;
}

    <h4>Pedido</h4>

    <table class="table table-bordered mb-4">
        <tr>
            <th>Núm. Pedido</th>
            <td>@Model.Id</td>
        </tr>
        <tr>
            <th>Fecha</th>
            <td>@Model.Fecha.ToShortDateString()</td>
        </tr>
        <tr>
            <th>Estado</th>
            <td>@Model.Estado?.Descripcion</td>
        </tr>
        <tr>
            <th>Cliente</th>
            <td>@Model.Cliente?.Nombre</td>
        </tr>
    </table>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Detalles)
            {
                decimal totalLinea = item.Cantidad * item.Precio;
                totalGeneral += totalLinea;

                <tr>
                    <td>@item.Producto?.Descripcion</td>

                    <td>
                        @if (item.Cantidad > 1)
                        {
                            <a asp-action="MenosCantidad"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary">-</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>-</button>
                        }

                        @item.Cantidad

                        <a asp-action="MasCantidad"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-primary">+</a>
                    </td>

                    <td>@item.Precio €</td>

                    <td>@totalLinea €</td>

                    <td>
                        <a asp-action="EliminarLinea"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total Pedido: @totalGeneral €</h4>

    <br />

    <a asp-controller="Escaparate"
       asp-action="Index"
       class="btn btn-volver">
        Seguir comprando
    </a>

    <a asp-action="ConfirmarPedido"
       asp-route-id="@Model.Id"
       class="btn btn-success">
        Confirmar Pedido
    </a>

