@model IEnumerable<PeonValienteMVC.Models.Idea>

@{
    ViewData["Title"] = "Ideas";
}

<h1>Ideas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva idea</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Colección</th>
                <th>Frase en español</th>
                <th>Potencial</th>
                <th>Estado</th>
                <th>Progreso</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>

                    <td>@item.Titulo</td>

                    <td>@item.Coleccion?.Nombre</td>

                    <td style="min-width: 260px;">
                        @item.FraseEspanol
                    </td>

                    <td>
                        @item.Potencial / 10
                    </td>

                    <td>
                        @item.Estado
                    </td>

                    <td style="min-width: 170px;">
                        <div>
                            <span class="me-2">
                                @(item.ImagenTerminada ? "✅ Imagen" : "⬜ Imagen")
                            </span>
                        </div>

                        <div>
                            <span class="me-2">
                                @(item.ArchivoPodTerminado ? "✅ POD" : "⬜ POD")
                            </span>
                        </div>

                        <div>
                            <span class="me-2">
                                @(item.MockupTerminado ? "✅ Mockup" : "⬜ Mockup")
                            </span>
                        </div>

                        <div>
                            <span class="me-2">
                                @(item.PublicadoEtsy ? "✅ Etsy" : "⬜ Etsy")
                            </span>
                        </div>

                        <div>
                            <span>
                                @(item.PublicadoPinterest ? "✅ Pinterest" : "⬜ Pinterest")
                            </span>
                        </div>
                    </td>

                    <td>
                        @item.FechaCreacion.ToString("dd/MM/yyyy")
                    </td>

                    <td style="min-width: 160px;">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info">
                            Detalles
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>