@model IEnumerable<PeonValienteMVC.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Crear Nuevo</a>
</p>

<div class="row">

    <!-- MENÚ IZQUIERDO -->
    <div class="col-md-3">
        <h4>Categorías</h4>

        <a class="d-block mb-2"
           asp-controller="Productos"
           asp-action="Index"
           asp-route-id="@null"
           asp-route-page="1">
            Todos
        </a>

        @foreach (var categoria in (IEnumerable<PeonValienteMVC.Models.Categoria>)ViewData["Categorias"])
        {
            <a class="d-block mb-2"
               asp-controller="Productos"
               asp-action="Index"
               asp-route-id="@categoria.Id"
               asp-route-page="1">
                @categoria.Descripcion
            </a>
        }
    </div>

    <!-- CONTENIDO DERECHA -->
    <div class="col-md-9">

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.Precio)</th>
                    <th>@Html.DisplayNameFor(model => model.Stock)</th>
                    <th>@Html.DisplayNameFor(model => model.Escaparate)</th>
                    <th>Imagen</th>
                    <th>@Html.DisplayNameFor(model => model.Categoria)</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Descripcion</td>
                        <td>@item.Precio</td>
                        <td>@item.Stock</td>
                        <td class="text-center">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @(item.Escaparate ? "checked" : "")
                                   disabled />
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.Imagen))
                            {
                                <img src="~/imagenes/@item.Imagen"
                                     width="80"
                                     height="80"
                                     style="object-fit:cover;"
                                     class="img-thumbnail"
                                     asp-append-version="true" />
                            }
                            else
                            {
                                <img src="~/imagenes/Sin.png"
                                     width="80"
                                     height="80"
                                     style="object-fit:cover;"
                                     class="img-thumbnail" />
                            }
                        </td>

                        <td>@item.Categoria.Descripcion</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Borrar</a> |
                            <a asp-action="CambiarImagen" asp-route-id="@item.Id">Cambiar Img</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- PAGINACIÓN -->
        <div class="mt-3">

            @if (ViewBag.Page > 1)
            {
                <a class="btn btn-outline-dark"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.Page - 1)">
                    Anterior
                </a>
            }

            <span class="mx-3">
                Página @ViewBag.Page de @ViewBag.TotalPages
            </span>

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <a class="btn btn-outline-dark"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.Page + 1)">
                    Siguiente
                </a>
            }

        </div>

    </div>

</div>

<a class="btn btn-volver text-white mt-3"
  
   asp-controller="Home"
   asp-action="Index">
    Volver al Inicio
</a>