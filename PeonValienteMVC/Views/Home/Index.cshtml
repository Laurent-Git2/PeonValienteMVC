@{
    ViewData["Title"] = "Inicio";
}

<div id="carouselPeonValiente" class="carousel slide mb-5" data-bs-ride="carousel">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselPeonValiente" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#carouselPeonValiente" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#carouselPeonValiente" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner rounded shadow mx-3">

        <!-- Slide 1 -->
        <div class="carousel-item active">
            <img src="~/imagenes//Carrusel/Slide1.png" class="d-block w-100" style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                <h2>Tableros Premium</h2>
                <p>Elegancia y calidad para verdaderos estrategas.</p>

                <a asp-controller="Escaparate"
                   asp-action="Index"
                   class="btn text-white mt-2"
                   style="background-color:#C9A14A;">
                    Ir a la tienda
                </a>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item">
            <img src="~/imagenes/Carrusel/Slide2.png" class="d-block w-100" style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                <h2>Relojes de Competición</h2>
                <p>Controla el tiempo como un campeón.</p>

                <a asp-controller="Escaparate"
                   asp-action="Index"
                   class="btn text-white mt-2"
                   style="background-color:#C9A14A;">
                    Ir a la tienda
                </a>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-item">
            <img src="~/imagenes/Carrusel/Slide3.png" class="d-block w-100" style="height:500px; object-fit:cover;" />

            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                <h2>Todo para tu juego</h2>
                <p>Piezas, bolsas, libros y accesorios.</p>

                <a asp-controller="Escaparate"
                   asp-action="Index"
                   class="btn text-white mt-2"
                   style="background-color:#C9A14A;">
                    Ir a la tienda
                </a>
            </div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselPeonValiente" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#carouselPeonValiente" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>
