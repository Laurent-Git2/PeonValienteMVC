@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desactivar la autenticación de dos factores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta acción solo desactiva la autenticación de dos factores.</strong>
    </p>
    <p>
        Desactivar la autenticación de dos factores no modifica las claves que se utilizan en las aplicaciones de autenticación. Si deseas cambiar la clave
        que se utiliza en una aplicación de autenticación, debes <a asp-page="./ResetAuthenticator">restablece tus claves de autenticación.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Disable 2FA</button>
    </form>
</div>
